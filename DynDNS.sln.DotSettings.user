	<s:String x:Key="/Default/CodeStyle/CSharpFileLayoutPatterns/Pattern/@EntryValue">&lt;?xml version="1.0" encoding="utf-16"?&gt;&#xD;
&lt;Patterns StaticFieldReorderingPolicy="Unrestricted" xmlns="urn:schemas-jetbrains-com:member-reordering-patterns"&gt;&#xD;
  &lt;TypePattern DisplayName="NoReorder annotation"&gt;&#xD;
    &lt;TypePattern.Match&gt;&#xD;
      &lt;Or&gt;&#xD;
        &lt;HasAttribute Name="JetBrains.Annotations.NoReorderAttribute" /&gt;&#xD;
        &lt;HasAttribute Name="JetBrains.Annotations.NoReorder" /&gt;&#xD;
      &lt;/Or&gt;&#xD;
    &lt;/TypePattern.Match&gt;&#xD;
  &lt;/TypePattern&gt;&#xD;
  &lt;TypePattern DisplayName="Default Pattern (StyleCop)" RemoveRegions="AllExceptGenerated"&gt;&#xD;
    &lt;Region Name="Dependency Properties" Priority="100"&gt;&#xD;
      &lt;DependencyProperty DisplayName="Dependency Properties" Priority="100"&gt;&#xD;
        &lt;Entry DisplayName="DP Key"&gt;&#xD;
          &lt;Entry.Match&gt;&#xD;
            &lt;DependencyPropertyPart Match="Key" /&gt;&#xD;
          &lt;/Entry.Match&gt;&#xD;
        &lt;/Entry&gt;&#xD;
        &lt;Entry DisplayName="DP Field"&gt;&#xD;
          &lt;Entry.Match&gt;&#xD;
            &lt;DependencyPropertyPart /&gt;&#xD;
          &lt;/Entry.Match&gt;&#xD;
        &lt;/Entry&gt;&#xD;
        &lt;Entry DisplayName="DP Handler"&gt;&#xD;
          &lt;Entry.Match&gt;&#xD;
            &lt;DependencyPropertyPart Match="Handler" /&gt;&#xD;
          &lt;/Entry.Match&gt;&#xD;
        &lt;/Entry&gt;&#xD;
        &lt;Entry DisplayName="DP Property"&gt;&#xD;
          &lt;Entry.Match&gt;&#xD;
            &lt;DependencyPropertyPart Match="Property" /&gt;&#xD;
          &lt;/Entry.Match&gt;&#xD;
        &lt;/Entry&gt;&#xD;
        &lt;Entry DisplayName="Attached DP Getter"&gt;&#xD;
          &lt;Entry.Match&gt;&#xD;
            &lt;DependencyPropertyPart Match="Getter" /&gt;&#xD;
          &lt;/Entry.Match&gt;&#xD;
        &lt;/Entry&gt;&#xD;
        &lt;Entry DisplayName="Attached DP Setter"&gt;&#xD;
          &lt;Entry.Match&gt;&#xD;
            &lt;DependencyPropertyPart Match="Setter" /&gt;&#xD;
          &lt;/Entry.Match&gt;&#xD;
        &lt;/Entry&gt;&#xD;
      &lt;/DependencyProperty&gt;&#xD;
      &lt;Property DisplayName="Properties w/ Backing Field" Priority="100"&gt;&#xD;
        &lt;Entry DisplayName="Backing Field"&gt;&#xD;
          &lt;Entry.Match&gt;&#xD;
            &lt;PropertyPart Match="Field" /&gt;&#xD;
          &lt;/Entry.Match&gt;&#xD;
        &lt;/Entry&gt;&#xD;
        &lt;Entry DisplayName="Property"&gt;&#xD;
          &lt;Entry.Match&gt;&#xD;
            &lt;PropertyPart Match="Property" /&gt;&#xD;
          &lt;/Entry.Match&gt;&#xD;
        &lt;/Entry&gt;&#xD;
      &lt;/Property&gt;&#xD;
    &lt;/Region&gt;&#xD;
    &lt;Region Name="Constants - Static fields - Fields"&gt;&#xD;
      &lt;Entry DisplayName="Static fields" Priority="100"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;Or&gt;&#xD;
            &lt;And&gt;&#xD;
              &lt;Kind Is="Field" /&gt;&#xD;
              &lt;Static /&gt;&#xD;
            &lt;/And&gt;&#xD;
            &lt;And&gt;&#xD;
              &lt;Kind Is="Field" /&gt;&#xD;
              &lt;Static /&gt;&#xD;
              &lt;Readonly /&gt;&#xD;
            &lt;/And&gt;&#xD;
          &lt;/Or&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
          &lt;Readonly /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
      &lt;Entry DisplayName="Fields"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;Kind Is="Field" /&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
          &lt;Readonly /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
      &lt;Entry DisplayName="Constants"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;Kind Is="Constant" /&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
    &lt;/Region&gt;&#xD;
    &lt;Region Name="Constructors and Destructors"&gt;&#xD;
      &lt;Entry DisplayName="Constructors and Destructors" Priority="200"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;Or&gt;&#xD;
            &lt;Kind Is="Constructor" /&gt;&#xD;
            &lt;Kind Is="Destructor" /&gt;&#xD;
          &lt;/Or&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;Static /&gt;&#xD;
          &lt;Kind Order="Constructor Destructor" /&gt;&#xD;
          &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
    &lt;/Region&gt;&#xD;
    &lt;Region Name="Delegates and Events"&gt;&#xD;
      &lt;Entry DisplayName="Delegates"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;Kind Is="Delegate" /&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
          &lt;Static /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
      &lt;Entry DisplayName="Public events"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;And&gt;&#xD;
            &lt;Kind Is="Event" /&gt;&#xD;
            &lt;Access Is="Public" /&gt;&#xD;
          &lt;/And&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;Access Order="Public" /&gt;&#xD;
          &lt;Static /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
      &lt;Entry DisplayName="Interface events"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;And&gt;&#xD;
            &lt;Kind Is="Event" /&gt;&#xD;
            &lt;ImplementsInterface /&gt;&#xD;
          &lt;/And&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;ImplementsInterface Immediate="True" /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
      &lt;Entry DisplayName="Other events"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;Kind Is="Event" /&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
          &lt;Static /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
    &lt;/Region&gt;&#xD;
    &lt;Region Name="Enums"&gt;&#xD;
      &lt;Entry DisplayName="Enums"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;Kind Is="Enum" /&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
    &lt;/Region&gt;&#xD;
    &lt;Entry DisplayName="Interfaces"&gt;&#xD;
      &lt;Entry.Match&gt;&#xD;
        &lt;Kind Is="Interface" /&gt;&#xD;
      &lt;/Entry.Match&gt;&#xD;
      &lt;Entry.SortBy&gt;&#xD;
        &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
        &lt;Name /&gt;&#xD;
      &lt;/Entry.SortBy&gt;&#xD;
    &lt;/Entry&gt;&#xD;
    &lt;Region Name="Properties"&gt;&#xD;
      &lt;Entry DisplayName="Public properties"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;And&gt;&#xD;
            &lt;Kind Is="Property" /&gt;&#xD;
            &lt;Access Is="Public" /&gt;&#xD;
          &lt;/And&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;Static /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
      &lt;Entry DisplayName="Interface properties"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;And&gt;&#xD;
            &lt;Kind Is="Property" /&gt;&#xD;
            &lt;ImplementsInterface /&gt;&#xD;
          &lt;/And&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;ImplementsInterface Immediate="True" /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
      &lt;Group DisplayName="Abstract not public properties"&gt;&#xD;
        &lt;Entry DisplayName="Abstract internal properties"&gt;&#xD;
          &lt;Entry.Match&gt;&#xD;
            &lt;And&gt;&#xD;
              &lt;Abstract /&gt;&#xD;
              &lt;Kind Is="Property" /&gt;&#xD;
              &lt;Access Is="Internal" /&gt;&#xD;
            &lt;/And&gt;&#xD;
          &lt;/Entry.Match&gt;&#xD;
          &lt;Entry.SortBy&gt;&#xD;
            &lt;Static /&gt;&#xD;
            &lt;Name /&gt;&#xD;
          &lt;/Entry.SortBy&gt;&#xD;
        &lt;/Entry&gt;&#xD;
        &lt;Entry DisplayName="Abstract private protected properties"&gt;&#xD;
          &lt;Entry.Match&gt;&#xD;
            &lt;And&gt;&#xD;
              &lt;Abstract /&gt;&#xD;
              &lt;Kind Is="Property" /&gt;&#xD;
              &lt;Or&gt;&#xD;
                &lt;Access Is="Private" /&gt;&#xD;
                &lt;Access Is="Protected" /&gt;&#xD;
              &lt;/Or&gt;&#xD;
            &lt;/And&gt;&#xD;
          &lt;/Entry.Match&gt;&#xD;
          &lt;Entry.SortBy&gt;&#xD;
            &lt;Static /&gt;&#xD;
            &lt;Name /&gt;&#xD;
          &lt;/Entry.SortBy&gt;&#xD;
        &lt;/Entry&gt;&#xD;
      &lt;/Group&gt;&#xD;
      &lt;Entry DisplayName="Other properties"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;Kind Is="Property" /&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
          &lt;Static /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
    &lt;/Region&gt;&#xD;
    &lt;Entry DisplayName="Public indexers" Priority="1000"&gt;&#xD;
      &lt;Entry.Match&gt;&#xD;
        &lt;And&gt;&#xD;
          &lt;Kind Is="Indexer" /&gt;&#xD;
          &lt;Access Is="Public" /&gt;&#xD;
        &lt;/And&gt;&#xD;
      &lt;/Entry.Match&gt;&#xD;
      &lt;Entry.SortBy&gt;&#xD;
        &lt;Static /&gt;&#xD;
        &lt;Name /&gt;&#xD;
      &lt;/Entry.SortBy&gt;&#xD;
    &lt;/Entry&gt;&#xD;
    &lt;Entry DisplayName="Interface indexers" Priority="1000"&gt;&#xD;
      &lt;Entry.Match&gt;&#xD;
        &lt;And&gt;&#xD;
          &lt;Kind Is="Indexer" /&gt;&#xD;
          &lt;ImplementsInterface /&gt;&#xD;
        &lt;/And&gt;&#xD;
      &lt;/Entry.Match&gt;&#xD;
      &lt;Entry.SortBy&gt;&#xD;
        &lt;ImplementsInterface Immediate="True" /&gt;&#xD;
        &lt;Name /&gt;&#xD;
      &lt;/Entry.SortBy&gt;&#xD;
    &lt;/Entry&gt;&#xD;
    &lt;Entry DisplayName="Other indexers" Priority="1000"&gt;&#xD;
      &lt;Entry.Match&gt;&#xD;
        &lt;Kind Is="Indexer" /&gt;&#xD;
      &lt;/Entry.Match&gt;&#xD;
      &lt;Entry.SortBy&gt;&#xD;
        &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
        &lt;Static /&gt;&#xD;
        &lt;Name /&gt;&#xD;
      &lt;/Entry.SortBy&gt;&#xD;
    &lt;/Entry&gt;&#xD;
    &lt;Region Name="Methods"&gt;&#xD;
      &lt;Entry DisplayName="Public methods and operators"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;And&gt;&#xD;
            &lt;Or&gt;&#xD;
              &lt;Kind Is="Method" /&gt;&#xD;
              &lt;Kind Is="Operator" /&gt;&#xD;
            &lt;/Or&gt;&#xD;
            &lt;Access Is="Public" /&gt;&#xD;
          &lt;/And&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;Static /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
      &lt;Entry DisplayName="Interface methods"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;And&gt;&#xD;
            &lt;Kind Is="Method" /&gt;&#xD;
            &lt;ImplementsInterface /&gt;&#xD;
          &lt;/And&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;ImplementsInterface Immediate="True" /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
      &lt;Entry DisplayName="Other methods"&gt;&#xD;
        &lt;Entry.Match&gt;&#xD;
          &lt;Kind Is="Method" /&gt;&#xD;
        &lt;/Entry.Match&gt;&#xD;
        &lt;Entry.SortBy&gt;&#xD;
          &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
          &lt;Static /&gt;&#xD;
          &lt;Name /&gt;&#xD;
        &lt;/Entry.SortBy&gt;&#xD;
      &lt;/Entry&gt;&#xD;
    &lt;/Region&gt;&#xD;
    &lt;Entry DisplayName="Operators"&gt;&#xD;
      &lt;Entry.Match&gt;&#xD;
        &lt;Kind Is="Operator" /&gt;&#xD;
      &lt;/Entry.Match&gt;&#xD;
      &lt;Entry.SortBy&gt;&#xD;
        &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
        &lt;Static /&gt;&#xD;
        &lt;Name /&gt;&#xD;
      &lt;/Entry.SortBy&gt;&#xD;
    &lt;/Entry&gt;&#xD;
    &lt;Entry DisplayName="Nested structs" Priority="600"&gt;&#xD;
      &lt;Entry.Match&gt;&#xD;
        &lt;Kind Is="Struct" /&gt;&#xD;
      &lt;/Entry.Match&gt;&#xD;
      &lt;Entry.SortBy&gt;&#xD;
        &lt;Static /&gt;&#xD;
        &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
        &lt;Name /&gt;&#xD;
      &lt;/Entry.SortBy&gt;&#xD;
    &lt;/Entry&gt;&#xD;
    &lt;Entry DisplayName="Nested classes" Priority="700"&gt;&#xD;
      &lt;Entry.Match&gt;&#xD;
        &lt;Kind Is="Class" /&gt;&#xD;
      &lt;/Entry.Match&gt;&#xD;
      &lt;Entry.SortBy&gt;&#xD;
        &lt;Static /&gt;&#xD;
        &lt;Access Order="Public Internal ProtectedInternal Protected Private" /&gt;&#xD;
        &lt;Name /&gt;&#xD;
      &lt;/Entry.SortBy&gt;&#xD;
    &lt;/Entry&gt;&#xD;
    &lt;Entry DisplayName="All other members" /&gt;&#xD;
  &lt;/TypePattern&gt;&#xD;
  &lt;TypePattern DisplayName="COM interfaces or structs"&gt;&#xD;
    &lt;TypePattern.Match&gt;&#xD;
      &lt;Or&gt;&#xD;
        &lt;And&gt;&#xD;
          &lt;Kind Is="Interface" /&gt;&#xD;
          &lt;Or&gt;&#xD;
            &lt;HasAttribute Name="System.Runtime.InteropServices.InterfaceTypeAttribute" /&gt;&#xD;
            &lt;HasAttribute Name="System.Runtime.InteropServices.ComImport" /&gt;&#xD;
          &lt;/Or&gt;&#xD;
        &lt;/And&gt;&#xD;
        &lt;Kind Is="Struct" /&gt;&#xD;
      &lt;/Or&gt;&#xD;
    &lt;/TypePattern.Match&gt;&#xD;
  &lt;/TypePattern&gt;&#xD;
  &lt;TypePattern DisplayName="P/Invoke classes called 'NativeMethods' (StyleCop)"&gt;&#xD;
    &lt;TypePattern.Match&gt;&#xD;
      &lt;And&gt;&#xD;
        &lt;Kind Is="Class" /&gt;&#xD;
        &lt;Name Is=".*NativeMethods" /&gt;&#xD;
      &lt;/And&gt;&#xD;
    &lt;/TypePattern.Match&gt;&#xD;
  &lt;/TypePattern&gt;&#xD;
  &lt;TypePattern DisplayName="DataMember serialisation classes (StyleCop)"&gt;&#xD;
    &lt;TypePattern.Match&gt;&#xD;
      &lt;And&gt;&#xD;
        &lt;Or&gt;&#xD;
          &lt;Kind Is="Field" /&gt;&#xD;
          &lt;Kind Is="Property" /&gt;&#xD;
        &lt;/Or&gt;&#xD;
        &lt;HasAttribute Name="System.Runtime.Serialization.DataMemberAttribute" /&gt;&#xD;
      &lt;/And&gt;&#xD;
    &lt;/TypePattern.Match&gt;&#xD;
  &lt;/TypePattern&gt;&#xD;
&lt;/Patterns&gt;</s:String>
